{
  "name": "soloagent",
  "private": true,
  "version": "0.1.0",
  "description": "One control plane for all of your AI agents. Durable agents on Pi, talking through Slack, Discord, Telegram, the web, and your terminal.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/client",
    "packages/core",
    "packages/server",
    "packages/cli",
    "packages/web"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run dev -w @soloagent/server",
    "dev:web": "npm run dev -w @soloagent/web",
    "build": "npm run build -w @soloagent/web",
    "start": "node packages/server/src/main.ts",
    "tui": "node packages/cli/src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @soloagent/web",
    "test": "node --test 'packages/*/test/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
