# Copy to .env and fill in. Every value is optional.

# Admin token for the dashboard, TUI, and API. Generate: openssl rand -base64 32
SOLOAGENT_TOKEN=

# Seals provider credentials and bot tokens at rest. Keep it stable once set.
SOLOAGENT_SECRET=

# Host port for docker compose (default 7420)
SOLOAGENT_PORT=7420

# 0 hides the built-in demo model
SOLOAGENT_DEMO=1
